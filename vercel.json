{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/dashboard",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/report", "schedule": "0 10 * * *" }
  ]
}
